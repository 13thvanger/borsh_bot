BOT_TOKEN=CHANGE_ME
BOT_ADMIN_IDS=123456789,987654321
MANUAL_ADD_BORSH_MAX=1000

POSTGRES_USER=borsh
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=borshbot
DATABASE_URL=postgresql+asyncpg://borsh:CHANGE_ME@db:5432/borshbot

# AI verification is enabled only when both AGENT_URL and AGENT_API_KEY are set.
AGENT_URL=
AGENT_API_KEY=
AGENT_MODEL=cifra48/agent
AGENT_TIMEOUT_SECONDS=60
AGENT_REQUIRED=false
AGENT_TIMEOUT_BYPASS=true

# Used by /borsh when the command is not a reply to a specific photo.
BORSH_PHOTO_WINDOW_MINUTES=15
